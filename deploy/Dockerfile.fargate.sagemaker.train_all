FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# boto3 is enough (ECS task role provides credentials)
RUN pip install --no-cache-dir boto3

COPY deploy/sagemaker/launch_sagemaker_training.py /app/launch_sagemaker_training.py

CMD ["python", "/app/launch_sagemaker_training.py"]
