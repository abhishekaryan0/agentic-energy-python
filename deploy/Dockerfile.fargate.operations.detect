FROM python:3.11-slim

# Lightweight image for batch operations detection on ECS Fargate

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt boto3

COPY . .

# Ensure operations uses this directory for loading models
ENV OPERATIONS_MODELS_DIR=/app/models
ENV PYTHONPATH=/app

# Batch entrypoint: run operations detection from S3 and write results to S3
CMD ["python", "-m", "scripts.run_operations_detection_s3"]

