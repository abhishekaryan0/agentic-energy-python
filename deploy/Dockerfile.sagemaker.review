# SageMaker inference container for anomaly review (per-well pipeline).
# Runs model_fn/input_fn/predict_fn/output_fn from deploy.sagemaker.review_inference.
# Requires Snowflake, Postgres, OpenAI env at runtime for full detect_anomalies().
FROM python:3.11-slim

# MMS (multi-model-server) started by sagemaker-inference requires Java
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libgomp1 default-jre-headless \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir \
    torch scikit-learn joblib pandas numpy \
    psycopg2-binary snowflake-connector-python python-dotenv openai \
    multi-model-server sagemaker-inference

# App: anomaly_review, config, deploy (review entrypoint only)
COPY anomaly_review ./anomaly_review
COPY config ./config
COPY deploy/__init__.py ./deploy/__init__.py
COPY deploy/sagemaker/__init__.py ./deploy/sagemaker/__init__.py
COPY deploy/sagemaker/review_inference.py ./deploy/sagemaker/review_inference.py

ENV PYTHONPATH=/app
ENV SAGEMAKER_PROGRAM=deploy.sagemaker.review_inference

EXPOSE 8080
ENTRYPOINT ["python", "-c", "from sagemaker_inference import model_server; model_server.start_model_server()"]
CMD ["serve"]
