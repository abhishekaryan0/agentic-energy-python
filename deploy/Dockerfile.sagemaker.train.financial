# SageMaker training container for financial model (implementation cost from invoices + production)
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends build-essential libgomp1 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN pip install --no-cache-dir pandas pyarrow boto3 scikit-learn joblib numpy

COPY financial ./financial
COPY deploy/__init__.py ./deploy/__init__.py
COPY deploy/sagemaker/__init__.py ./deploy/sagemaker/__init__.py
COPY deploy/sagemaker/train_financial.py ./deploy/sagemaker/train_financial.py

ENV PYTHONPATH=/app
ENTRYPOINT ["python", "-m", "deploy.sagemaker.train_financial"]

