# SageMaker inference container: runs model_fn/input_fn/predict_fn/output_fn from deploy.sagemaker.inference
FROM python:3.11-slim

# MMS (multi-model-server) started by sagemaker-inference requires Java
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libgomp1 default-jre-headless \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install inference deps: multi-model-server + sagemaker-inference (no sagemaker_inference.server module; use model_server)
COPY requirements.txt .
RUN pip install --no-cache-dir \
    torch scikit-learn joblib pandas numpy \
    snowflake-connector-python python-dotenv \
    multi-model-server sagemaker-inference

# App code (anomaly_detection, config, deploy package)
COPY anomaly_detection ./anomaly_detection
COPY config ./config
COPY deploy/__init__.py ./deploy/__init__.py
COPY deploy/sagemaker/__init__.py ./deploy/sagemaker/__init__.py
COPY deploy/sagemaker/inference.py ./deploy/sagemaker/inference.py

ENV PYTHONPATH=/app
ENV SAGEMAKER_PROGRAM=deploy.sagemaker.inference

# SageMaker runs: docker run <image> serve. sagemaker-inference has model_server, not server.
EXPOSE 8080
ENTRYPOINT ["python", "-c", "from sagemaker_inference import model_server; model_server.start_model_server()"]
CMD ["serve"]
