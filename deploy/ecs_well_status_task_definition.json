{
  "family": "well-status-batch",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "EXECUTION_ROLE_ARN",
  "taskRoleArn": "TASK_ROLE_ARN",
  "containerDefinitions": [
    {
      "name": "well-status",
      "image": "IMAGE_URI",
      "essential": true,
      "environment": [
        { "name": "S3_BUCKET", "value": "S3_BUCKET_VALUE" },
        { "name": "ORGANIZATION_ID", "value": "ORGANIZATION_ID_VALUE" },
        { "name": "AWS_REGION", "value": "AWS_REGION_VALUE" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "LOG_GROUP_NAME",
          "awslogs-region": "AWS_REGION_VALUE",
          "awslogs-stream-prefix": "well-status"
        }
      }
    }
  ]
}
