# SageMaker training: daily_production + invoices -> financial_implementation_cost.joblib
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends build-essential libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY financial/deploy/requirements.training.txt ./requirements.training.txt
RUN pip install --no-cache-dir -r requirements.training.txt

COPY financial ./financial

ENV PYTHONPATH=/app

ENTRYPOINT ["python", "-m", "financial.sagemaker_train"]
