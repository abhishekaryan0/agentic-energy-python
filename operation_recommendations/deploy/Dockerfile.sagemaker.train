# SageMaker training container: sensor + production parquet -> action models in /opt/ml/model
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends build-essential libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN pip install --no-cache-dir pandas pyarrow boto3 scikit-learn joblib numpy psycopg2-binary python-dotenv

COPY operation_recommendations ./operation_recommendations
COPY s3_to_postgres ./s3_to_postgres

ENV PYTHONPATH=/app

ENTRYPOINT ["python", "-m", "operation_recommendations.sagemaker_train"]
