# SageMaker training container: reads sensor_data channel (parquet), writes model to /opt/ml/model
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN pip install --no-cache-dir \
    pandas pyarrow boto3 \
    scikit-learn joblib numpy pyod torch

COPY anomaly_detection ./anomaly_detection

ENV PYTHONPATH=/app

ENTRYPOINT ["python", "-m", "anomaly_detection.sagemaker_train"]
