# SageMaker training container: reads sensor_data channel (parquet), writes model to /opt/ml/model
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# CPU-only torch (SageMaker ml.m5.* has no GPU); avoids ~4GB CUDA layers and slow ECR pushes.
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir pandas pyarrow boto3 scikit-learn joblib numpy pyod

COPY anomaly_detection ./anomaly_detection

ENV PYTHONPATH=/app

ENTRYPOINT ["python", "-m", "anomaly_detection.sagemaker_train"]
