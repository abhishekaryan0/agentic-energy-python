# Container image for AWS Lambda: STEP V2 synthetic data → Snowflake *_V2 tables.
FROM public.ecr.aws/lambda/python:3.11

COPY SOUTH_TEXAS_ENERGY_PARTNERS/v2/deploy/requirements.lambda.txt ${LAMBDA_TASK_ROOT}/requirements.txt
RUN pip install --no-cache-dir -r ${LAMBDA_TASK_ROOT}/requirements.txt

COPY SOUTH_TEXAS_ENERGY_PARTNERS ${LAMBDA_TASK_ROOT}/SOUTH_TEXAS_ENERGY_PARTNERS

ENV PYTHONPATH=${LAMBDA_TASK_ROOT}

CMD ["SOUTH_TEXAS_ENERGY_PARTNERS.v2.handler.handler"]
